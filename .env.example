# CorePulse environment configuration
# Copy to .env and customize before running

# ── Application ────────────────────────────────────────────────────────────────
APP_NAME=CorePulse
APP_VERSION=1.0.0
ENV=production
DEBUG=false

# !! REQUIRED: Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE-THIS-generate-with-openssl-rand-hex-32

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
WORKERS=4
ALLOWED_ORIGINS=https://your-domain.com,http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=CHANGE-THIS-strong-password-here
DATABASE_URL=postgresql+asyncpg://corepulse:CHANGE-THIS-strong-password-here@db:5432/corepulse
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=

# ── JWT ────────────────────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true

# ── SNMP ──────────────────────────────────────────────────────────────────────
SNMP_DEFAULT_COMMUNITY=public
SNMP_DEFAULT_VERSION=2c

# ── Proxmox ───────────────────────────────────────────────────────────────────
PROXMOX_VERIFY_SSL=false

# ── FlashSystem ───────────────────────────────────────────────────────────────
FLASHSYSTEM_VERIFY_SSL=false

# ── Alerting ──────────────────────────────────────────────────────────────────
ALERT_EVALUATION_INTERVAL=30
ALERT_COOLDOWN_SECONDS=300

# ── Email notifications ────────────────────────────────────────────────────────
SMTP_HOST=smtp.your-domain.com
SMTP_PORT=587
SMTP_USER=alerts@your-domain.com
SMTP_PASSWORD=
SMTP_TLS=true
SMTP_FROM=alerts@your-domain.com

# ── Slack notifications ────────────────────────────────────────────────────────
SLACK_DEFAULT_WEBHOOK_URL=

# ── Teams notifications ────────────────────────────────────────────────────────
TEAMS_DEFAULT_WEBHOOK_URL=

# ── Telegram notifications ─────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── Metrics retention ─────────────────────────────────────────────────────────
METRICS_RETENTION_DAYS=90
